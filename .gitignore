# ==========================================
# NarrativeShift Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
firebase-credentials.json
*-credentials.json
*.pem
*.key
*.cert
*.p12

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDEs & Operating Systems
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs
logs/
*.log

# Large Generated Artifacts & Model Caches
# Note: Raw embeddings and large npy dumps are excluded from git.
# Metadata and JSON summary files are tracked.
*.npy
backend/models/*.npy
models/*.npy
.cache/
huggingface/
torch/

# Temporary data / local dumps
data/temp/
backend/data/temp/
*.dump
*.sql.gz
