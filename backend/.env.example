# ==========================================
# NarrativeShift - Environment Configuration
# ==========================================
# Copy this file to .env and configure with your credentials.

# ------------------------------------------
# 1. External APIs
# ------------------------------------------
# The Guardian OpenPlatform API Key
# Sign up at: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_api_key_here

# Groq API Key (Used for LLM analysis with openai/gpt-oss-120b)
# Sign up at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (Defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------
# 2. Database Configuration
# ------------------------------------------
# PostgreSQL Database URL (Neon PostgreSQL connection string)
# Format: postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------
# 3. Authentication & CORS
# ------------------------------------------
# Neon Auth or Better Auth backend service URL
NEON_AUTH_URL=https://auth.example.com

# Allowed CORS origins (comma-separated URLs for frontend access)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Application environment: development | production
ENVIRONMENT=development
